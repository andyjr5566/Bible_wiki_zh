{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "introduction_content.schema.json",
  "title": "Book Introduction Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book",
    "book_folder",
    "status",
    "navigation",
    "source_policy",
    "header",
    "modules",
    "references"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "book": {"type": "string", "minLength": 1},
    "book_folder": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outline", "first_chapter"],
      "properties": {
        "outline": {"type": "string", "minLength": 1},
        "first_chapter": {"type": "string", "minLength": 1}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editorial_anchor",
        "commentary_vote_sources",
        "external_context_sources"
      ],
      "properties": {
        "editorial_anchor": {"type": "string", "minLength": 1},
        "commentary_vote_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "external_context_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "public_note": {"type": "string"}
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lead", "source_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "lead": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "overview": {"$ref": "#/$defs/overview"},
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorship_context", "message_purpose", "structure"],
      "properties": {
        "identity": {"$ref": "#/$defs/module"},
        "authorship_context": {"$ref": "#/$defs/module"},
        "message_purpose": {"$ref": "#/$defs/module"},
        "importance_features": {"$ref": "#/$defs/module"},
        "structure": {"$ref": "#/$defs/module"},
        "key_texts_themes": {"$ref": "#/$defs/module"},
        "canonical_relationship": {"$ref": "#/$defs/module"}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "$defs": {
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "body": {"type": "string", "minLength": 1}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "source_ids"],
      "properties": {
        "title": {"type": "string"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fact"}
        },
        "source_ids": {"$ref": "#/$defs/sourceIds"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "outlineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range", "label", "summary"],
      "properties": {
        "range": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "keyText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "significance"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "significance": {"type": "string", "minLength": 1}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids"],
      "properties": {
        "enabled": {"type": "boolean"},
        "title": {"type": "string"},
        "paragraphs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "source_ids": {"$ref": "#/$defs/sourceIds"},
        "callout": {"$ref": "#/$defs/callout"},
        "facts": {
          "type": "array",
          "items": {"$ref": "#/$defs/fact"}
        },
        "mermaid": {"type": "string", "minLength": 1},
        "features": {
          "type": "array",
          "items": {"$ref": "#/$defs/feature"}
        },
        "outline": {
          "type": "array",
          "items": {"$ref": "#/$defs/outlineItem"}
        },
        "key_texts": {
          "type": "array",
          "items": {"$ref": "#/$defs/keyText"}
        },
        "key_words": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "themes": {
          "type": "array",
          "items": {"$ref": "#/$defs/theme"}
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      }
    }
  }
}
