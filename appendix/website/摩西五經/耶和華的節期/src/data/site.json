  "entries": {
    "三大節期": {
      "gist": "一年三次朝見神的節期：除酵節、收割節、收藏節（出23:14-17）。",
      "title": "三大節期",
      "type": "神學"
    },
    "亞筆月": {
      "gist": "以色列宗教曆的正月，名字意思是「初熟之穀」；被擄後改稱尼散月。",
      "title": "亞筆月",
      "type": "原文"
    },
    "以本月為正月": {
      "gist": "出12:2 把出埃及的那個月定為一年之首，重訂了整套年曆的起算點。",
      "title": "以本月為正月",
      "type": "主題"
    },
    "基督預表（逾越節羔羊）": {
      "gist": "新約把基督稱為「我們逾越節的羔羊」（林前5:7）。",
      "title": "基督預表（逾越節羔羊）",
      "type": "神學"
    },
    "滅命的": {
      "gist": "出12:23 擊殺埃及長子的那一位；是天使還是神自己，解法不一。",
      "title": "滅命的",
      "type": "神學"
    },
    "無酵餅": {
      "gist": "沒有發酵的餅；逾越節當夜同吃，無酵節七日都要吃。",
      "title": "無酵餅",
      "type": "原文"
    },
    "牛膝草": {
      "gist": "拿來蘸血、打在門楣和門框上的小草；後來也用在潔淨的儀式裡。",
      "title": "牛膝草",
      "type": "原文"
    },
    "第十災（殺長子之災）": {
      "gist": "十災的最後一災：半夜擊殺埃及地所有的長子和頭生的牲畜。",
      "title": "第十災（殺長子之災）",
      "type": "歷史"
    },
    "苦菜": {
      "gist": "逾越節當夜和羊羔、無酵餅同吃的苦味菜，記念在埃及為奴的苦。",
      "title": "苦菜",
      "type": "原文"
    },
    "逾越節": {
      "gist": "正月十四日黃昏宰羊、塗血、吃羊羔的節期，記念耶和華越過以色列人的家。",
      "title": "逾越節",
      "type": "歷史"
    },
    "逾越節羔羊": {
      "gist": "正月初十挑選、十四日宰殺的無殘疾一歲公羊羔，綿羊山羊都可以。",
      "title": "逾越節羔羊",
      "type": "歷史"
    }
  },
  "motto": {
    "book": "利未記",
    "chapter": 23,
    "from": 2,
    "lines": [
      {
        "text": "你曉諭以色列人說：耶和華的節期，你們要宣告為聖會的節期。",
        "v": 2
      }
    ],
    "ref": "利23:2",
    "to": 2
  },
