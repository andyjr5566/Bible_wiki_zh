    "出12:7": {
      "book": "出埃及記",
      "chapter": 12,
      "from": 7,
      "lines": [
        {
          "text": "各家要取點血，塗在吃羊羔的房屋左右的門框上和門楣上。",
          "v": 7
        }
      ],
      "ref": "出12:7",
      "to": 7
    },
    "出13:3-4": {
      "book": "出埃及記",
      "chapter": 13,
      "from": 3,
      "lines": [
        {
          "text": "摩西對百姓說：你們要記念從埃及為奴之家出來的這日，因為耶和華用大能的手將你們從這地方領出來。有酵的餅都不可吃。",
          "v": 3
        },
        {
          "text": "亞筆月間的這日是你們出來的日子。",
          "v": 4
        }
      ],
      "ref": "出13:3-4",
      "to": 4
    },
    "利23:2": {
      "book": "利未記",
      "chapter": 23,
      "from": 2,
      "lines": [
        {
          "text": "你曉諭以色列人說：耶和華的節期，你們要宣告為聖會的節期。",
          "v": 2
        }
      ],
      "ref": "利23:2",
      "to": 2
    },
    "利23:5": {
      "book": "利未記",
      "chapter": 23,
      "from": 5,
      "lines": [
        {
          "text": "正月十四日，黃昏的時候，是耶和華的逾越節。",
          "v": 5
        }
      ],
      "ref": "利23:5",
      "to": 5
    },
    "民28:16": {
      "book": "民數記",
      "chapter": 28,
      "from": 16,
      "lines": [
        {
          "text": "正月十四日是耶和華的逾越節。",
          "v": 16
        }
      ],
      "ref": "民28:16",
      "to": 16
    },
    "申16:1-7": {
      "book": "申命記",
      "chapter": 16,
      "from": 1,
      "lines": [
        {
          "text": "你要注意亞筆月，向耶和華─你的神守逾越節，因為耶和華─你的神在亞筆月夜間領你出埃及。",
          "v": 1
        },
        {
          "text": "你當在耶和華所選擇要立為他名的居所，從牛群羊群中，將逾越節的祭牲獻給耶和華─你的神。",
          "v": 2
        },
        {
          "text": "你吃這祭牲，不可吃有酵的餅；七日之內要吃無酵餅，就是困苦餅─你本是急忙出了埃及地─要叫你一生一世記念你從埃及地出來的日子。",
          "v": 3
        },
        {
          "text": "在你四境之內，七日不可見麵酵，頭一日晚上所獻的肉，一點不可留到早晨。",
          "v": 4
        },
        {
          "text": "在耶和華─你神所賜的各城中，你不可獻逾越節的祭；",
          "v": 5
        },
        {
          "text": "只當在耶和華─你神所選擇要立為他名的居所，晚上日落的時候，乃是你出埃及的時候，獻逾越節的祭。",
          "v": 6
        },
        {
          "text": "當在耶和華─你神所選擇的地方把肉烤了吃（烤：或作煮），次日早晨就回到你的帳棚去。",
          "v": 7
        }
      ],
      "ref": "申16:1-7",
      "to": 7
    }
  }
}
